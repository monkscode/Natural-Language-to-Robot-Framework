# Test Runner Image - Optimized build using shared base
# Base: nlrf-base-browser (Chrome + Playwright + UV + Xvfb + system deps)
# Size: ~900MB (vs 2.7GB unoptimized) - 67% reduction

ARG BASE_IMAGE=monkscode/nlrf:base-browser-latest
FROM ${BASE_IMAGE}

# Install Robot Framework packages using UV with cache
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --no-cache \
    robotframework \
    robotframework-seleniumlibrary \
    robotframework-browser \
    playwright && \
    rfbrowser init --skip-browsers && \
    python -m playwright install chromium

# Copy virtual display helper script
COPY scripts/start-with-display.sh /usr/local/bin/start-with-display.sh
RUN chmod +x /usr/local/bin/start-with-display.sh

# Set Chrome options for healing sessions
ENV CHROME_OPTIONS="--headless=new --no-sandbox --disable-dev-shm-usage --disable-gpu --window-size=1920,1080"

# Use the display script as entrypoint
ENTRYPOINT ["/usr/local/bin/start-with-display.sh"]

# Default command (can be overridden)
CMD ["robot", "--version"]
