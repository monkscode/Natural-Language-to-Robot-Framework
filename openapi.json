        "summary": "Get Aggregate Metrics",
        "description": "Get aggregated workflow metrics for monitoring and analysis.\n\nReturns:\n- Total workflows executed\n- Total elements processed\n- Average success rate\n- Average LLM calls per element\n- Average cost per element\n- Custom action usage rate\n- Average execution time\n\nUse either date range (start_date/end_date) or last_days parameter.",
        "operationId": "get_aggregate_metrics_api_workflow_metrics_aggregate_get",
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Start date (ISO format: YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS)",
              "title": "Start Date"
            },
            "description": "Start date (ISO format: YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS)"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "End date (ISO format: YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS)",
              "title": "End Date"
            },
            "description": "End date (ISO format: YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS)"
          },
          {
            "name": "last_days",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 365,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Get metrics for last N days (alternative to date range)",
              "title": "Last Days"
            },
            "description": "Get metrics for last N days (alternative to date range)"
          }
        ],
        "responses": {
