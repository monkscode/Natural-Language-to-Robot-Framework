    "/test/containers/cleanup": {
      "delete": {
        "summary": "Cleanup Test Containers Endpoint",
        "description": "Clean up all test-related containers.\n\nNote: This endpoint uses the docker_service.cleanup_test_containers() function\nwhich specifically targets \"robot-test-*\" containers. There is also a standalone\nCLI tool (tools/cleanup_docker_containers.py) that provides more comprehensive\ncleanup including test-runner-* containers. Both are kept as they serve \ndifferent purposes: API endpoint for programmatic cleanup vs manual CLI tool \nfor comprehensive maintenance.",
        "operationId": "cleanup_test_containers_endpoint_test_containers_cleanup_delete",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
