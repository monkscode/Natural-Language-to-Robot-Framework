# React SPA microservice — multi-stage build.
# Stage 1: build the Vite/TypeScript bundle with Node.
# Stage 2: serve the static bundle with nginx, reverse-proxying the API to fastapi.
#
# Build context is the repo root (see docker-compose.yml `context: .`), so all
# COPY paths are repo-relative. node_modules/dist are excluded via .dockerignore.

# ============================================================================
# STAGE 1: Build
# ============================================================================
FROM node:22-alpine AS build

WORKDIR /app

# Install dependencies first (cached layer keyed on manifest changes only).
# package-lock.json is included if present so builds are reproducible (npm ci);
# falls back to npm install when no lockfile exists yet.
COPY src/frontend-react/package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

# Copy the rest of the frontend source and produce the production build.
COPY src/frontend-react/ ./
RUN npm run build

# ============================================================================
# STAGE 2: Serve
# ============================================================================
# Unprivileged variant: runs as the non-root nginx user (uid 101) and listens
# on 8080 (non-root processes cannot bind ports below 1024).
FROM nginxinc/nginx-unprivileged:alpine

# SPA routing + API reverse-proxy config (proxies /api,/auth,/reports,/health
# to the fastapi compose service so the SPA and API share one origin).
COPY src/frontend-react/nginx.conf /etc/nginx/conf.d/default.conf

# Static bundle from the build stage.
COPY --from=build /app/dist /usr/share/nginx/html


# --- Build identity -------------------------------------------------------
# Last layer on purpose: it changes on every commit, so anything above it stays
# cached. `-develop` and `-latest` are moving tags, so the tag a container was
# pulled under does not identify the code inside it; this does.
#   docker inspect -f '{{index .Config.Labels "org.opencontainers.image.revision"}}' IMAGE
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.revision=$GIT_SHA

EXPOSE 8080

# 127.0.0.1 explicitly: busybox wget resolves `localhost` to ::1 first and
# nginx listens on IPv4 only, so a localhost URL is always Connection refused.
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
