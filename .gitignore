# Environment variables
**/.env

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# Logs
*.log*
logs/audit

# Virtual environment
venv/
venv-bus/
.venv/

# Robot Test Files
robot_tests/

# Test files
test.py

# Ignore the AI generated md/instruction files
.kiro
.cursor
.claude
.vscode
.codex
.github/copilot-instructions.md
tmpclaude-*

# Ignore the jsonl files
*.jsonl

# Ignore the database content
chroma_db/
data/*
# ...except pre-generated libdocs: the app reads these instead of importing
# robotframework, the same way the FastAPI image does.
!data/libdocs/
logs/temp_metrics
# Postgres data volume (auth/users DB) + React build output
pgdata/
src/frontend-react/dist/
src/frontend-react/tsconfig.tsbuildinfo

# Ignore the local browser_service
tools/browser_service/*

# requirements.txt is a generated artifact (compiled from pyproject.toml at Docker build time)
# Do not commit — the Dockerfile runs `uv pip compile pyproject.toml` at build time
src/backend/requirements.txt
node_modules/
coverage/

docs/tasks/
# Owner rule: plans and specs live on disk only, never committed. Enforced here
# so `git add -A` cannot sweep them in. docs/superpowers/acceptance/ is
# deliberately NOT ignored — it is tracked.
docs/superpowers/plans/
docs/superpowers/specs/
# Top-level notes (HANDOFF-*, FINDINGS-*, UPSTREAM-*) were untracked but NOT
# ignored, so `git add -A` could still sweep them in. `*` does not match `/`,
# so this covers direct children only and leaves acceptance/ tracked.
docs/superpowers/*.md
.agents/workflows/development-workflow.md
tasks/*
logs/crewai.log.txt
CLAUDE.md
credentials.json
FuturePlans/*

tests/test_clients/
clients/integrity/*
# Customer configs stay local: this repository is public, and a client config
# carries the customer's name, their URL patterns, and prompt text describing
# their internal screens. Matched by SHAPE rather than by name, so this rule
# names no customer and a new one is covered without anyone remembering to add
# it. clients/loader.py discovers client dirs by iterating this folder and
# falls back to _default, so an absent one costs nothing; tests/test_clients/
# is already local-only for the same reason.
# Untracking does NOT remove anything from history — that is a separate rewrite.
clients/*/
!clients/_default/

# Bench harness: bench data stays local — run evidence, new baseline CSVs
# (operational metrics), and private/ (customer query sets) are never committed.
# The frozen 2026-07-03 public baseline predates this rule and stays tracked
# as the comparison reference.
bench/runs/
bench/baselines/
bench/private/