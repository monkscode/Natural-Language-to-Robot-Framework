# Browser Service Dockerfile - Optimized with shared base (PR #20 style)
# Single-stage build with system Chrome only
FROM devasy23/nlrf:base-browser-latest

WORKDIR /app

# Install browser-service and its dependencies using UV
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --no-cache \
    flask \
    playwright \
    browser-service

# Install Playwright Chromium (required by browser-use library)
# browser-use needs Playwright's browser, can't use system Chrome
RUN playwright install chromium

# Copy application source code
COPY src/ /app/src/
COPY tools/ /app/tools/

# Expose browser service port
EXPOSE 4999

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:4999/health || exit 1

# Run browser service
CMD ["python", "tools/browser_use_service.py"]
