    },
    "/api/workflow-metrics/": {
      "get": {
        "tags": [
          "workflow-metrics"
        ],
        "summary": "Get Workflow Metrics",
        "description": "Get workflow metrics with optional date filtering.\n\nReturns metrics for browser-use workflows including:\n- Total elements processed\n- Success rate\n- LLM call counts and costs\n- Custom action usage\n- Execution times",
        "operationId": "get_workflow_metrics_api_workflow_metrics__get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "description": "Maximum number of workflows to return",
              "default": 100,
              "title": "Limit"
            },
            "description": "Maximum number of workflows to return"
          },
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Start date (ISO format: YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS)",
              "title": "Start Date"
            },
            "description": "Start date (ISO format: YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS)"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "End date (ISO format: YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS)",
              "title": "End Date"
            },
            "description": "End date (ISO format: YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WorkflowMetricsResponse"
                  },
                  "title": "Response Get Workflow Metrics Api Workflow Metrics  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/workflow-metrics/aggregate": {
      "get": {
